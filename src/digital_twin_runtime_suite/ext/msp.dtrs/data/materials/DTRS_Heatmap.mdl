mdl 1.7;

import ::df::*;
import ::math::*;
import ::state::*;
import ::tex::*;

float dtrs_clamp01(float value) = value < 0.0 ? 0.0 :
    (value > 1.0 ? 1.0 : value);

color dtrs_segment(
    float value,
    float lower_stop,
    color lower_color,
    float upper_stop,
    color upper_color
) = upper_stop <= lower_stop ? upper_color : math::lerp(
    lower_color,
    upper_color,
    dtrs_clamp01((value - lower_stop) / (upper_stop - lower_stop))
);

color dtrs_palette(
    float scalar,
    int active_stop_count,
    float stop_0, color color_0,
    float stop_1, color color_1,
    float stop_2, color color_2,
    float stop_3, color color_3,
    float stop_4, color color_4,
    float stop_5, color color_5
) = let {
    float value = dtrs_clamp01(scalar);
} in value <= stop_0 ? color_0 :
    active_stop_count <= 2 || value <= stop_1 ? dtrs_segment(
        value, stop_0, color_0, stop_1, color_1
    ) :
    active_stop_count <= 3 || value <= stop_2 ? dtrs_segment(
        value, stop_1, color_1, stop_2, color_2
    ) :
    active_stop_count <= 4 || value <= stop_3 ? dtrs_segment(
        value, stop_2, color_2, stop_3, color_3
    ) :
    active_stop_count <= 5 || value <= stop_4 ? dtrs_segment(
        value, stop_3, color_3, stop_4, color_4
    ) :
    value <= stop_5 ? dtrs_segment(
        value, stop_4, color_4, stop_5, color_5
    ) : color_5;

export material DTRS_Heatmap(
    uniform texture_2d telemetry_texture = texture_2d(),
    uniform int telemetry_texel_index = 0,
    float temperature_offset_celsius = 0.0,
    float delta_minimum_celsius = -10.0,
    float delta_maximum_celsius = 10.0,
    float scale_minimum_celsius = 0.0,
    float scale_maximum_celsius = 100.0,
    float minimum_clamp_scalar = 0.0,
    float maximum_clamp_scalar = 1.0,
    int active_stop_count = 6,
    float stop_0 = 0.0, color color_0 = color(0.0, 0.0, 1.0),
    float stop_1 = 0.2, color color_1 = color(0.0, 1.0, 1.0),
    float stop_2 = 0.4, color color_2 = color(0.0, 1.0, 0.0),
    float stop_3 = 0.6, color color_3 = color(1.0, 1.0, 0.0),
    float stop_4 = 0.8, color color_4 = color(1.0, 0.5, 0.0),
    float stop_5 = 1.0, color color_5 = color(1.0, 0.0, 0.0)
) = let {
    float thermal_weight = dtrs_clamp01(state::texture_coordinate(0).x);
    float delta = math::lerp(
        delta_minimum_celsius,
        delta_maximum_celsius,
        thermal_weight
    );
    float telemetry_celsius = tex::texture_isvalid(telemetry_texture) ?
        tex::lookup_float(
            telemetry_texture,
            float2((float(telemetry_texel_index) + 0.5) / 256.0, 0.5),
            tex::wrap_clamp,
            tex::wrap_clamp
        ) : 60.0;
    float temperature = telemetry_celsius + temperature_offset_celsius + delta;
    float scale_span = scale_maximum_celsius - scale_minimum_celsius;
    float temperature_scalar = scale_span <= 0.0 ? 0.0 : dtrs_clamp01(
        (temperature - scale_minimum_celsius) / scale_span
    );
    float clamp_span = maximum_clamp_scalar - minimum_clamp_scalar;
    float palette_scalar = clamp_span <= 0.0 ? 0.0 : dtrs_clamp01(
        (temperature_scalar - minimum_clamp_scalar) / clamp_span
    );
    color heatmap_color = dtrs_palette(
        palette_scalar,
        active_stop_count,
        stop_0, color_0,
        stop_1, color_1,
        stop_2, color_2,
        stop_3, color_3,
        stop_4, color_4,
        stop_5, color_5
    );
} in material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(tint: heatmap_color),
        emission: material_emission(
            df::diffuse_edf(),
            intensity: heatmap_color * color(1.5)
        )
    )
);
